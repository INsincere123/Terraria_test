	BlackHoleStaff: {
		DisplayName: 黑洞
		Tooltip:
			'''
			召唤[c/0F0000:黑洞]，发射[c/00B8FF:高能类星体喷流]
			每个[c/0F0000:黑洞]占用9个召唤栏，最多召唤4个[c/0F0000:黑洞]
