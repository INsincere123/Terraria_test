Items: {
	StatBoostToggle: {
		DisplayName: 成神之路
		Tooltip:
			'''
			开启成神之路
			全属性强化，部分武器大幅强化
			再次使用可关闭
			'''
	}

	GodModeToggle: {
		DisplayName: 你已成神
		Tooltip: 全属性大幅强化，再次使用可关闭
	}

	Antares: {
		DisplayName: 心宿二
		Tooltip:
			'''
			召唤蝎子座，发射追踪火焰，命中敌人后爆炸
			5%概率触发爆发射击
			'''
	}

	ThunderBreathingStaff: {
		Tooltip: ""
		DisplayName: 雷之呼吸
	}

	OmniGuardianAccessory: {
		DisplayName: 神之心
		Tooltip: ""
	}

	JuLingHat: {
		DisplayName: 聚灵法冠
		Tooltip:
			'''
			[c/6495ED:+10%] 魔法伤害  [c/6495ED:+10%] 魔法暴击
			[c/6495ED:+80] 最大法力值  [c/6495ED:-10%] 法力消耗
			'''
	}

	JuLingRobe: {
		DisplayName: 聚灵法衣
		Tooltip: "[c/6495ED:+7%] 魔法伤害  [c/6495ED:+7%] 魔法暴击"
	}

	JuLingLeggings: {
		DisplayName: 聚灵法绔
		Tooltip: "[c/6495ED:+5%] 魔法伤害  [c/6495ED:+5%] 移动速度"
	}

	AntaresBreastplate: {
		DisplayName: Antares Breastplate
		Tooltip: ""
	}

	AntaresHelmet: {
		DisplayName: Antares Helmet
		Tooltip: ""
	}

	AntaresLeggings: {
		DisplayName: Antares Leggings
		Tooltip: ""
	}

	MoonStride: {
		DisplayName: 逐月踏空靴
		Tooltip: ""
	}

	SupercritPotion: {
		Tooltip:
			'''
			超出100%暴击的部分转换为暴击伤害
			每1%的暴击率转换为2%的暴击伤害
			'''
		DisplayName: 超暴击药水
	}

	SupercritGoggles: {
		Tooltip: 提高25%暴击率并获得超暴击buff
		DisplayName: 超暴击护目镜
	}

	Heartsteel: {
		DisplayName: 心之钢
		Tooltip:
			'''
			免疫击退
			靠近 Boss [c/FFD700:2秒]后，下一次命中触发：
			  造成 [c/FF8C00:240 + 88% 最大生命] 的额外伤害
			  获得该伤害 [c/6495ED:0.8%] 的永久最大生命值（上限 [c/6495ED:+200]）
			每有 [c/FF8C00:100 点最大生命]，体型变大 [c/FF4500:5%]（上限 +100%）
			[c/AAAAAA:叠层在卸下装备后保留，重新装备时继续生效]
			[c/AAAAAA:骑乘坐骑时不修改体型]
			'''
	}

	FocusOrb: {
		DisplayName: 专注宝珠
		Tooltip: "[c/6495ED:+8%] 全属性伤害  [c/6495ED:+6%] 暴击率  [c/6495ED:+5] 护甲穿透"
	}

	BerserkBlade: {
		DisplayName: 狂暴之刃
		Tooltip:
			'''
			命中提供 [c/FF8C00:狂暴] 叠层，持续 [c/FFD700:2 秒]
			每层：近战攻速 [c/6495ED:+4%]（上限 [c/6495ED:+40%]）
			[c/FF4500:满 10 层]时，额外造成 [c/FF4500:100 + 17% 触发伤害] 的真实伤害
			[c/AAAAAA:物品直接命中：每次叠 1 层，立即触发]
			[c/AAAAAA:近战弹幕命中：每 5 次叠 1 层；满层后每 3 次触发一次]
			'''
	}

	AshenSeal: {
		Tooltip: 每点防御力增加1%伤害，但将防御力清零
		DisplayName: 焚骸圣印
	}

	TimeStopRing: {
		DisplayName: 时停戒指
		Tooltip: ""
	}

	Offhand: {
		DisplayName: 磁球
		Tooltip: 召唤磁球，命中敌人时发射追加弹幕，造成19%额外伤害
	}

	TestWhip: {
		Tooltip: ""
		DisplayName: Test Whip
	}

	SlowField: {
		Tooltip: 在你周围生成一个减速立场，减速敌方弹幕
		DisplayName: 减速立场
	}

	TestHook: {
		Tooltip: ""
		DisplayName: Test Hook
	}

	ReflectShieldItem: {
		Tooltip: ""
		DisplayName: 反射
	}

	DRShieldItem: {
		Tooltip: ""
		DisplayName: 减伤
	}

	AbsorbShieldItem: {
		Tooltip: ""
		DisplayName: 格挡
	}

	SwordQiSword: {
		DisplayName: 泰拉棱镜
		Tooltip:
			'''
			命中敌人后在目标处留下剑气，高速来回切割
			重复命中同一目标可[c/FFD700:叠层]（上限100层），每次命中刷新持续时间

			[c/FF8C00:伤害] 1-10层缓慢积累，11-20层急速飙升，20层后趋于稳定
			[c/FF8C00:频率] 达到10层与20层时切割速度分别加快一次
			[c/7B68EE:极限] 叠至100层时，衍生出对称的第二道剑气

			剑气颜色随叠层变化：
			· [c/CCCCCC:1-10层]  无色薄边
			· [c/FFD700:11-20层] 金黄渐变[c/8A2BE2:蓝紫]
			· [c/6495ED:20层以上] 冰蓝发光
			剑气持续10秒
			'''
	}

	BloodFeedKnife: {
		DisplayName: 血饲匕首
		Tooltip: ""
	}

	CollectorItem: {
		DisplayName: 收集者
		Tooltip:
			'''
			[c/FF4500:Boss 血量低于 7% 时：]任意命中触发[c/FF4500:处决]，并获得铂金币
			同时获得 [c/AAFFAA:幸运] 效果，持续 20 分钟
			[c/AAAAAA:奖励范围：3～60 铂金币]
			'''
	}

	EnergyShieldItem: {
		DisplayName: 能量护盾
		Tooltip:
			'''
			装备后获得能量护盾，上限为 [c/50A0FF:20 + 6% 最大生命值]
			护盾状态下 [c/50FF50:+5 防御力]，且免疫击退
			护盾吸收全部伤害；6 秒未受击后瞬间恢复满值
			[c/AAAAAA:护盾破碎时不造成特殊效果]
			'''
	}

	SuperEnergyShieldItem: {
		DisplayName: 超能护盾
		Tooltip:
			'''
			装备后获得能量护盾，上限为 [c/64C8FF:60 + 120% 防御力]
			护盾状态下 [c/50FF50:+5% 减伤]、[c/50FF50:+4% 伤害]、[c/50FF50:+2% 暴击]，且免疫击退
			护盾吸收全部伤害；5 秒未受击后 [c/FFD700:2 秒]内逐渐恢复
			[c/FF6060:生命值跌破 30% 时：]获得 [c/FF6060:50% 最大生命 + 100% 防御]的紧急护盾
			紧急护盾在 4.5 秒内衰减，冷却 120 秒
			'''
	}

	HuangQuanAltarItem: {
		DisplayName: 黄泉馈灵塔
		Tooltip:
			'''
			放置后在周围 [c/9370DB:160 格]范围内形成黄泉光环
			[c/AAAAAA:Boss 进入范围时激活所有效果：]
			· 范围内[c/7FFF00:友方 NPC 或队友]阵亡后，短暂获得 [c/FF6060:汲命] 效果
			· 范围内[c/FF4500:敌方 NPC] 被击杀后，短暂获得 [c/FF8C00:杀意] 效果
			· 每 [c/FFD700:5 秒]对范围内所有敌方 NPC 造成 [c/FF4500:100] 点脉冲伤害
			· 对 Boss 额外附加 [c/FF4500:500] 点平伤
			'''
	}
}

