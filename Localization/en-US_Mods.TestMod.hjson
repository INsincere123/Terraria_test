	}

	VortexQuiver: {
		DisplayName: 星璇箭袋
		Tooltip:
			'''
			箭矢伤害×1.1，远程暴击率提高5%
			提高箭矢速度和击退，20%几率不消耗箭矢
			箭矢重力降低80%，命中使敌人带电5秒
			'''
		ModeDefault: 当前模式：默认——按弹药栏顺序轮换箭矢
		ModeFull: 当前模式：全域——在弹药栏和整个物品栏中顺序轮换箭矢
		ModeRandom: 当前模式：随机——在弹药栏和整个物品栏中随机选择箭矢
		ModeSimple: 当前模式：普通——按正常顺序使用箭矢
		GravityUnavailable: 普通箭低重力效果暂不可用
	}

	VortexAmmoBelt: {
		DisplayName: 星璇弹药腰带
		Tooltip:
			'''
			子弹伤害×1.1，远程暴击率提高5%
			子弹及其衍生攻击命中使敌人带电5秒
			'''
		ModeDefault: 当前模式：默认——按弹药栏顺序轮换子弹
		ModeFull: 当前模式：全域——在弹药栏和整个物品栏中顺序轮换子弹
		ModeRandom: 当前模式：随机——在弹药栏和整个物品栏中随机选择子弹
		ModeSimple: 当前模式：普通——按正常顺序使用子弹
	}

	VortexRocketBox: {
		DisplayName: 星璇炮弹箱
		Tooltip:
			'''
			火箭伤害×1.1，远程暴击率提高5%
			火箭飞行速度×2，强化火箭及其爆炸不会伤害自己
			火箭及其衍生攻击命中使敌人带电5秒
			'''
		ModeDefault: 当前模式：默认——按弹药栏顺序轮换火箭
		ModeFull: 当前模式：全域——在弹药栏和整个物品栏中顺序轮换火箭
		ModeRandom: 当前模式：随机——在弹药栏和整个物品栏中随机选择火箭
		ModeSimple: 当前模式：普通——按正常顺序使用火箭
	}

	TimeEchoCore: {
		DisplayName: 时之回响核心
		Tooltip:
			'''
			消耗后获得时之幻影能力
			记录5秒后，幻影会复现你5秒前的位置
			回溯：回溯时空，获得1秒无敌帧
			回溯后5秒内每秒恢复8点生命，增加20%减伤
			回溯冷却30秒，第25秒重新开始记录，第30秒恢复幻影
			互换：移动至幻影位置，获得0.25秒无敌帧
			互换后3秒内伤害×1.2，冷却10秒，第5秒开始重新记录，第10秒恢复幻影
			'''
	}

	TimeEchoDisruptor: {
		DisplayName: 时之断裂器
		Tooltip: 消耗后移除时之幻影能力
	}

	MomentumConverter: {
		DisplayName: 动量转换器
		Tooltip:
			'''
			将当前合速度转向鼠标指向位置
			储存两层充能，每2秒回复一层
			两层时保留全部速度，一层时保留50%速度
			转换后0.5秒内免疫坠落伤害与击退
			矿车与钩爪状态下无法使用
			'''
		ActivationHint: 按 [{0}] 转换动量
	}

