Items: {
	AegisShield: {
		DisplayName: 神盾
		Tooltip:
			'''
			双击方向键发动盾击冲刺
			速度 23.3 px/帧，命中后立即停止
			[c/6495ED:碰撞伤害 200（近战加成），命中无敌 12 帧]
			'''
	}

	VoidSash: {
		DisplayName: 虚空腰带
		Tooltip:
			'''
			双击方向键发动高速冲刺
			起始速度 64 px/帧，第 10 帧起逐帧衰减
