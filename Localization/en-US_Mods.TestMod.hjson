Items: {
	LifetakingSpear: {
		DisplayName: 索命长矛
		Tooltip:
			'''
			投出长矛，命中敌人后与其连接[c/FFD700:10秒]
			连接期间，主动武器及其派生攻击无需命中也能伤害该敌人
			同一次攻击机会只造成一次伤害，不叠加
			不包括召唤物、哨兵和追加攻击
			每次投掷后需等待[c/FFD700:30秒]
			'''
	}

	OutlandCombatTechniquesVolumeOne: {
		DisplayName: 外域战斗技术卷一
		Tooltip:
			'''
			永久强化本世界的城镇居民：防御增加[c/6495ED:6]，伤害加成增加[c/FF8C00:20%]
			可与先进战斗技术及其卷二叠加
			每世界仅可使用[c/FFD700:一次]，使用后消耗
			'''
	}

	OutlandCombatTechniquesVolumeTwo: {
		DisplayName: 外域战斗技术卷二
		Tooltip:
			'''
			永久强化本世界的城镇居民：防御增加[c/6495ED:100]，最大生命增加[c/6495ED:1000]
			伤害提高[c/FF8C00:150%]，攻击速度提高[c/6495ED:50%]
			可与外域战斗技术卷一和两本先进战斗技术叠加，无需先使用卷一
			每世界仅可使用[c/FFD700:一次]，使用后消耗，不恢复当前生命
			'''
	}

	StarfallObsidianEmblem: {
		DisplayName: 星陨黑曜圣徽
		Tooltip:
			'''
			缓慢恢复生命，治疗药水的耐药性时间缩短[c/6495ED:25%]
			受伤时释放蜜蜂、落星，并获得短暂惊慌
			延长受伤后的无敌时间
			免疫击退，获得黑曜石皮肤效果
			'''
	}

	ShieldOfCthulhuPlus: {
		DisplayName: 克苏鲁护盾+
		Tooltip:
			'''
			[c/6495ED:15%]概率闪避攻击，受到的伤害减少[c/6495ED:15%]
			免疫击退，获得黑曜石皮肤效果
			可水平冲刺并穿过敌人
			'''
	}

	OldOnesVeil: {
		DisplayName: 旧日支配者的帷幕
		Tooltip:
			'''
			缓慢恢复生命，治疗药水的耐药性时间缩短[c/6495ED:25%]
			治疗药水的生命回复量增加[c/50FF50:20%]
			受伤时释放蜜蜂、落星，获得短暂惊慌并可能混乱附近敌人
			延长受伤后的无敌时间
			[c/6495ED:22%]概率闪避攻击，受到的伤害减少[c/6495ED:15%]
			免疫击退和十字章护盾防护的异常状态
			可水平冲刺并穿过敌人
			'''
	}

	TerraWings: {
		DisplayName: 泰拉之翼
		Tooltip:
			'''
			外观随泰拉套职业变化
			无限飞行时间，大幅提高飞行速度，按住 ↑ 可加速垂直飞行
			按住下和跳跃键悬停，仅按下键快速下落并穿透平台
			提高奔跑速度、移动加速度与制动能力，移动速度增加[c/6495ED:50%]
			免疫击退与熔岩伤害，在水中自由移动并能够攀墙
			重力提高50%，不受太空低重力影响
			强化钩爪，被钩爪拉动时获得[c/6495ED:10%]伤害减免和[c/6495ED:50%]荆棘，减伤持续至松钩后[c/FFD700:1秒]
			可水平冲刺穿过敌怪
			'''
		JumpsEnabled: 额外跳跃：开启（气球束三段跳与屁罐跳）
		JumpsDisabled: 额外跳跃：关闭
		SlowModeEnabled: 慢速模式：开启（常规水平移速上限[c/FFD700:55 mph]，冲刺不受限制）
		SlowModeDisabled: 慢速模式：关闭
		SlowModeHint: 按住Shift并左键点击背包或饰品栏中的此物品切换慢速模式
		SingleKeyDash: 按 [{0}] 水平冲刺
		DoubleTapDash: 双击左右方向键水平冲刺
		DashHitImmunity: 冲刺撞击命中敌怪后获得[c/FFD700:{0}秒]无敌时间
	}

