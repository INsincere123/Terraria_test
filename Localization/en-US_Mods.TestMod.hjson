Configs: {
	TestModServerConfig: {
		DisplayName: TestMod 玩法设置
		Headers.Prefixes: 前缀开关

		EnableRefinementPrefixes: {
			Label: 启用炼化前缀
			Tooltip: 关闭时不加载任何炼化前缀，也不会出现在重铸候选中。已有炼化暂存为缺失词条且无加成，重新开启并重载后恢复；主动重铸覆盖后不恢复。联机使用服务端设置。
		}

		EnableFusionPrefix: {
			Label: 启用融合前缀
			Tooltip: 关闭时不加载融合前缀，也不会出现在重铸候选中。已有融合暂存为缺失词条且无加成，重新开启并重载后恢复；主动重铸覆盖后不恢复。联机使用服务端设置。
		}
	}

	TestModClientConfig: {
		DisplayName: TestMod 客户端设置

		Headers: {
			Dash: 冲刺
			ShieldUI: 护盾 UI
		}

		SingleTapDash: {
			Label: 单键触发冲刺
			Tooltip:
				'''
				开启后，按【单键冲刺】键（默认 V）触发水平冲刺，屏蔽对应的左右双击。
				支持本模组、原版、灾厄水平冲刺，以及 CalamityOverhaul 的赤影、血雾和纱幕步。
				方向优先跟随按住的左右键，否则跟随移动方向，静止时跟随人物朝向。
				向上、向下双击与独立技能键保持原样。关闭时恢复各系统原有按键。
				'''
		}

		ShowStandaloneShieldBar: {
			Label: 显示独立护盾条
			Tooltip: 在原版生命条左侧显示护盾数值、普通与紧急护盾区段，以及恢复阶段和倒计时。
		}

		StandaloneShieldBarOffsetX: {
			Label: 独立护盾条 X 偏移
			Tooltip: 调整独立护盾条的水平位置。正数向右，负数向左。
		}

		StandaloneShieldBarOffsetY: {
			Label: 独立护盾条 Y 偏移
			Tooltip: 调整独立护盾条的垂直位置。正数向下，负数向上。
		}
	}
}

EnvironmentEffects: {
	AbyssImmunity: 灾厄：深渊视野清晰，水中正常移动，免除深渊扣氧、窒息、降防、离水伤害与第一层硫磺水中毒
	TheDarkImmunity: 旅人归途：解除暗处（迷宫）的黑色遮盖，保留正常光照
}

ArmorToggle: {
	Enabled: 已开启
	Disabled: 已关闭
