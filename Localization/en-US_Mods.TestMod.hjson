	CollectorItem: {
		DisplayName: 收集者
		Tooltip:
			'''
			[c/FF4500:Boss 血量低于 7% 时：]任意命中触发[c/FF4500:处决]，并获得铂金币
			同时获得 [c/AAFFAA:幸运] 效果，持续 20 分钟
			处决 2 个 Boss 后开始获得属性，进入困难模式强化
			处决世纪之花、石巨人和月亮领主分别强化一次
			[c/AAAAAA:奖励范围：3～60 铂金币]
			'''
	}

	EnergyShieldItem: {
		DisplayName: 能量护盾
		Tooltip:
			'''
			装备后获得能量护盾，上限为 [c/50A0FF:20 + 6%最大生命值]
			护盾状态下 [c/50FF50:+5防御力]，且免疫击退
			11秒未受击后开始恢复，每秒恢复普通护盾总上限的1/6（空盾6秒回满）
			普通状态整次挡伤；开始恢复后直到普通护盾回满，破盾时溢出伤害穿透
			首次装备满盾，重戴不刷新；复活立即开始渐进恢复
			[c/AAAAAA:护盾破碎时不造成特殊效果]
			'''
	}

	SuperEnergyShieldItem: {
		DisplayName: 超能护盾
		Tooltip:
			'''
			装备后获得能量护盾，上限为 [c/64C8FF:60 + 120%防御力+9%最大生命值]
			护盾状态下 [c/50FF50:+5%减伤]、[c/50FF50:+4%伤害]、[c/50FF50:+2%暴击]，且免疫击退
			11秒未受击后开始恢复，每秒恢复普通护盾总上限的1/6（空盾6秒回满）
			普通状态整次挡伤；开始恢复后直到普通护盾回满，破盾时溢出伤害穿透
			首次装备满盾，重戴不刷新；复活立即开始渐进恢复
			[c/FF6060:生命值跌破30%时：]获得 [c/FF6060:50%最大生命 + 100%防御]的紧急护盾
			紧急护盾优先吸收伤害，在4.5秒内衰减，不解除恢复脆弱状态；冷却120秒（卸装及死亡期间继续）
			'''
	}

	HuangQuanAltarItem: {
		DisplayName: 黄泉馈灵塔
		Tooltip:
			'''
			放置后在周围 [c/9370DB:160 格]范围内形成黄泉光环
			[c/AAAAAA:Boss 进入范围时激活所有效果：]
			· 范围内[c/7FFF00:友方 NPC 或队友]阵亡后，短暂获得 [c/FF6060:汲命] 效果
			· 范围内[c/FF4500:敌方 NPC] 被击杀后，短暂获得 [c/FF8C00:杀意] 效果
			· 每 [c/FFD700:5 秒]对范围内所有敌方 NPC 造成 [c/FF4500:100] 点脉冲伤害
			· 对 Boss 额外附加 [c/FF4500:500] 点平伤
			'''
	}

	SuperRelocator: {
		DisplayName: 超级定位器
		Tooltip:
			'''
			传送到鼠标位置
			传送后静止 [c/FFD700:1 秒]，期间：
			  [c/6495ED:0.15 秒内]按方向键/跳跃 → 继承传送前速度
			  [c/AAAAAA:0.15~1 秒]按方向键/跳跃 → 解除静止，重新起步
