	WarriorSeal: {
		DisplayName: 战士之证
		Tooltip:
			'''
			防御力提高15，仇恨提高600
			近战伤害提高[c/6495ED:25%]，近战暴击率提高[c/6495ED:10%]，近战攻速提高[c/6495ED:20%]
