		DisplayName: 超暴击护目镜
	}

	AdversityAmulet: {
		DisplayName: 习难护符
		Tooltip:
			'''
			生命恢复 +4 点/秒，防御 +18，最大生命 +60
			免疫常见减益效果
			受到的接触伤害降低 11%
			实际受伤后适应该种攻击，每层降低其伤害 15%，最多 5 层
			同种 NPC 的接触攻击或同种弹幕共用适应，接触与弹幕分别分类
			适应持续 11 秒，同种攻击命中后叠层并刷新时间，满层也会刷新
			首次攻击不享受适应减伤；不同攻击命中后改为该种攻击的 1 层
			有适应层数时，本饰品的生命恢复、防御、生命上限及接触减伤翻倍
			环境伤害清空适应；陷阱弹幕仍可适应，持续掉血不影响适应
			闪避、免疫及护盾完全吸收不改变适应；卸装、死亡或到期清空
			'''
		AdaptationState: 适应：{0}/{1} 层，该种攻击减伤 {2}%，剩余 {3} 秒
	}

	Heartsteel: {
		DisplayName: 心之钢
		Tooltip:
			'''
			免疫击退
			装备时伤害降低 [c/FF4500:1/3]
			耐药性降低25%，获得蜂蜜效果
			靠近 Boss [c/FFD700:2秒]后，下一次命中触发：
			  造成 [c/FF8C00:240 + 88% 最大生命] 的额外伤害
			  受当前武器类型的伤害加成影响，并按玩家暴击率独立暴击
			  获得该伤害 [c/6495ED:0.8%] 的永久最大生命值（上限 [c/6495ED:+666]）
			每有 [c/FF8C00:100 点最大生命]，体型变大 [c/FF4500:5%]（上限 +100%）
			[c/AAAAAA:叠层在卸下装备后保留，重新装备时继续生效]
			[c/AAAAAA:骑乘坐骑时不修改体型]
			'''
	}

	FocusOrb: {
		DisplayName: 专注宝珠
		Tooltip: "[c/6495ED:+8%] 全属性伤害  [c/6495ED:+6%] 暴击率  [c/6495ED:+4] 护甲穿透"
		ExtraHitRule: "[c/AAAAAA:按实际命中伤害取比例，不重复增伤或暴击]"
