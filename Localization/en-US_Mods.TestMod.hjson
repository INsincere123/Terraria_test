Configs: {
	TestModServerConfig: {
		DisplayName: TestMod 玩法设置
		Headers.Prefixes: 前缀开关

		EnableRefinementPrefixes: {
			Label: 启用炼化前缀
			Tooltip: 关闭后无法获得炼化前缀，已有炼化前缀暂时失效。重新开启并重载模组后恢复；期间重铸替换的前缀不会恢复。联机以服务端设置为准。
		}

		EnableFusionPrefix: {
			Label: 启用融合前缀
			Tooltip: 关闭后无法获得融合前缀，已有融合前缀暂时失效。重新开启并重载模组后恢复；期间重铸替换的前缀不会恢复。联机以服务端设置为准。
		}
	}

	TestModClientConfig: {
		DisplayName: TestMod 客户端设置

		Headers: {
			Dash: 冲刺
			ShieldUI: 护盾 UI
		}

		SingleTapDash: {
			Label: 单键触发冲刺
			Tooltip:
				'''
				开启后，按【单键冲刺】键（默认 V）水平冲刺，关闭对应的左右双击冲刺。
				支持本模组、原版、灾厄，以及 CalamityOverhaul 的赤影、血雾和纱幕步。
				按住左／右键选择方向；未按方向键时沿移动方向冲刺，静止时沿人物朝向。
				上下双击与其他技能按键不受影响；关闭此选项后恢复双击冲刺。
				'''
		}

		ShowStandaloneShieldBar: {
			Label: 显示独立护盾条
			Tooltip: 在原版生命条左侧显示护盾数值、普通与紧急护盾区段，以及恢复阶段和倒计时。
		}

		StandaloneShieldBarOffsetX: {
			Label: 独立护盾条 X 偏移
			Tooltip: 调整独立护盾条的水平位置。正数向右，负数向左。
		}

		StandaloneShieldBarOffsetY: {
			Label: 独立护盾条 Y 偏移
			Tooltip: 调整独立护盾条的垂直位置。正数向下，负数向上。
		}
	}
}

