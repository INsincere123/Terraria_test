	RangerSeal: {
		DisplayName: 射手之证
		Tooltip:
			'''
			远程伤害提高[c/6495ED:25%]，远程暴击率提高[c/6495ED:10%]
			[c/6495ED:20%]几率不消耗弹药，仇恨降低400
			拥有熔火箭袋功能：普通箭转化为火焰箭，箭矢速度与击退提高，[c/6495ED:20%]几率不消耗箭矢
			箭矢重力减半，支持星璇式弹种轮换
			火箭速度提高且爆炸不会伤害自己
			可与星璇饰品同时生效，同类弹药优先使用星璇饰品的模式
			'''
		ModeDefault: 当前模式：默认——按弹药栏顺序轮换弹药
		ModeFull: 当前模式：全域——在弹药栏和整个物品栏中顺序轮换弹药
		ModeRandom: 当前模式：随机——在弹药栏和整个物品栏中随机选择弹药
		ModeSimple: 当前模式：普通——按正常顺序使用弹药
	}

	SorcererSeal: {
		DisplayName: 法师之证
		Tooltip:
			'''
			最大魔力值提高60，魔力消耗降低[c/6495ED:12%]
			魔法伤害提高[c/6495ED:25%]，魔法暴击率提高[c/6495ED:10%]
